# Browser OIDC configuration. example.com is reserved for documentation.
OIDC_AUTHORITY=https://auth.example.com/realms/example
OIDC_CLIENT_ID=studio

# API authentication.
K8S_STUDIO_KEYCLOAK_SERVER_URL=https://auth.example.com
K8S_STUDIO_KEYCLOAK_REALM=example
K8S_STUDIO_KEYCLOAK_CLIENT_ID=studio
K8S_STUDIO_KEYCLOAK_CLIENT_SECRET=
K8S_STUDIO_ALLOW_UNAUTHENTICATED_LOCAL=false

# PII Engine workload mTLS. Replace the client paths with local files.
# The insecure option is valid only for exact loopback hosts; never use it remotely.
K8S_STUDIO_PII_ENGINE_URL=https://127.0.0.1:8443
K8S_STUDIO_PII_ENGINE_CA_CERT=
K8S_STUDIO_PII_ENGINE_CLIENT_CERT=/absolute/path/to/studio-client.crt
K8S_STUDIO_PII_ENGINE_CLIENT_KEY=/absolute/path/to/studio-client.key
K8S_STUDIO_PII_ENGINE_ALLOW_INSECURE_LOCAL=true
K8S_STUDIO_PII_ENGINE_TIMEOUT=30

# Optional API-key bridge.
K8S_STUDIO_KEYCLOAK_API_KEY_BRIDGE_URL=http://127.0.0.1:8085

# Optional log search. Keep TLS verification enabled whenever possible.
K8S_STUDIO_OPENSEARCH_URL=https://127.0.0.1:9200
K8S_STUDIO_OPENSEARCH_CA_CERT=
K8S_STUDIO_OPENSEARCH_ALLOW_INSECURE_LOCAL=false
K8S_STUDIO_OPENSEARCH_USER=studio-logs-read
K8S_STUDIO_OPENSEARCH_PASSWORD=

# Optional usage integration.
K8S_STUDIO_LANGFUSE_URL=http://127.0.0.1:3001
K8S_STUDIO_LANGFUSE_PUBLIC_KEY=
K8S_STUDIO_LANGFUSE_SECRET_KEY=
K8S_STUDIO_USAGE_TIMEZONE=UTC
