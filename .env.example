# Browser OIDC configuration. example.com is reserved for documentation.
OIDC_AUTHORITY=https://auth.example.com/realms/example
OIDC_CLIENT_ID=studio

# API authentication.
K8S_STUDIO_KEYCLOAK_SERVER_URL=https://auth.example.com
K8S_STUDIO_KEYCLOAK_REALM=example
K8S_STUDIO_KEYCLOAK_CLIENT_ID=studio
K8S_STUDIO_KEYCLOAK_CLIENT_SECRET=
K8S_STUDIO_ALLOW_UNAUTHENTICATED_LOCAL=false

# PII Engine workload mTLS. Replace the client paths with local files.
# The insecure option is valid only for exact loopback hosts; never use it remotely.
K8S_STUDIO_PII_ENGINE_URL=https://127.0.0.1:8443
K8S_STUDIO_PII_ENGINE_CA_CERT=
K8S_STUDIO_PII_ENGINE_CLIENT_CERT=/absolute/path/to/studio-client.crt
K8S_STUDIO_PII_ENGINE_CLIENT_KEY=/absolute/path/to/studio-client.key
K8S_STUDIO_PII_ENGINE_ALLOW_INSECURE_LOCAL=true
K8S_STUDIO_PII_ENGINE_TIMEOUT=30

# Optional API-key bridge.
K8S_STUDIO_KEYCLOAK_API_KEY_BRIDGE_URL=http://127.0.0.1:8085

# Optional log search. Keep TLS verification enabled whenever possible.
K8S_STUDIO_OPENSEARCH_URL=https://127.0.0.1:9200
K8S_STUDIO_OPENSEARCH_CA_CERT=
K8S_STUDIO_OPENSEARCH_ALLOW_INSECURE_LOCAL=false
K8S_STUDIO_OPENSEARCH_USER=studio-logs-read
K8S_STUDIO_OPENSEARCH_PASSWORD=

# Optional private AgentGateway usage analytics integration.
K8S_STUDIO_AGENTGATEWAY_ADMIN_URL=http://127.0.0.1:15000
K8S_STUDIO_USAGE_TIMEZONE=Europe/Berlin

# Personal LLM activity, off by default. Only the Studio API gets these credentials.
K8S_STUDIO_LLM_LOGS_ENABLED=false
K8S_STUDIO_LANGFUSE_URL=
K8S_STUDIO_LANGFUSE_PUBLIC_KEY=
K8S_STUDIO_LANGFUSE_SECRET_KEY=

# MCP integration catalog (off by default). IDs and origin policies are operator-owned.
# All native registrations must use the same stable ContextForge team ID.
K8S_STUDIO_MCP_CATALOG_ENABLED=false
K8S_STUDIO_CONTEXTFORGE_TEAM_ID=
K8S_STUDIO_MCP_CATALOG=[]
# Sample entry: {"id":"github","name":"GitHub","authentication_model":"individual-authentication","gateway_id":"native-registration-id","server_id":"native-server-id","oauth_authorization_origin":"https://github.com"}
# Native gateway OAuth URLs/credentials are prepared by operators, not browsers.

# Native account preparation only, with a random bootstrap password discarded
# server-side. Native account login remains private.
K8S_STUDIO_CONTEXTFORGE_ACCOUNT_ONBOARDING_ENABLED=false
K8S_STUDIO_CONTEXTFORGE_URL=
K8S_STUDIO_CONTEXTFORGE_CA_CERT=
# Legacy bearer provisioning only, when native bearer authentication is enabled.
# Native trusted-proxy mode ignores JWTs: do not configure/forward a token for it.
K8S_STUDIO_CONTEXTFORGE_SERVICE_TOKEN=
K8S_STUDIO_CONTEXTFORGE_SERVICE_AUTH_MODE=bearer
# For personal connections select trusted-proxy and set a fixed operator-approved
# active, verified, NON-admin native service account, not PLATFORM_ADMIN_EMAIL.
# This identity must come only from Studio API configuration, never the browser.
K8S_STUDIO_CONTEXTFORGE_SERVICE_ACCOUNT_EMAIL=
K8S_STUDIO_CONTEXTFORGE_GLOBAL_ROLE_ID=
K8S_STUDIO_CONTEXTFORGE_TEAM_ROLE_ID=
# Operators provision a global role with NO permissions, and a team role with
# exactly tools.read, tools.execute, servers.read, servers.use, gateways.read;
# neither may inherit another role. Match native DEFAULT_USER_ROLE and
# DEFAULT_TEAM_MEMBER_ROLE to those role names, AUTO_CREATE_PERSONAL_TEAMS=false.
# The service identity needs exactly admin.user_management, teams.read,
# teams.manage_members across active non-inheriting global/fixed-team roles;
# it must hold active native owner membership in the configured non-personal team.
# Do not leave broader native team_admin grants on the provisioning service account.
# trusted-proxy requires private ingress limited to approved Studio/Gateway callers;
# operator-controlled Gateway routes must not expose native administrative APIs.
# New accounts remain inactive until verified; failed partial setup needs operator
# repair. Existing disabled/admin/unrelated-role accounts are never overwritten.
# Resolving existing accounts is read-only: missing/revoked roles or membership
# require operator repair, not automatic re-granting.
# Native public login/password-reset routes must remain unexposed by operators.

# Personal native OAuth, off by default. Operators own runtime adoption checks.
# No PAT/API-key entry. See README for explicit provisioning service authentication,
# actual-encryption preflight, callback/network/log protection and status limits.
K8S_STUDIO_MCP_CONNECTIONS_ENABLED=false
# Exact approved HTTPS Studio origin, without trailing slash (POST Origin check).
K8S_STUDIO_CONTEXTFORGE_OAUTH_STUDIO_ORIGIN=https://studio.example.com
# Public GET routed to Studio API on the same Studio origin, never directly to native.
K8S_STUDIO_CONTEXTFORGE_OAUTH_CALLBACK_URL=https://studio.example.com/oauth/callback
