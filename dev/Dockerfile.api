FROM ghcr.io/astral-sh/uv:0.11.21 AS uv
FROM python:3.12-slim
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy PYTHONUNBUFFERED=1
WORKDIR /workspace/apps/api
COPY apps/api/pyproject.toml apps/api/uv.lock apps/api/LICENSE ./
RUN uv sync --frozen --dev --no-install-project
COPY apps/api/src ./src
RUN uv sync --frozen --dev
CMD ["uv", "run", "--no-sync", "uvicorn", "k8s_stack_studio.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "4010", "--reload", "--reload-dir", "/workspace/apps/api/src"]
